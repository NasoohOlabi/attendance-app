{
  "name": "attendance-app",
  "version": "0.1.11",
  "private": true,
  "description": "Masjid attendance fingerprint app",
  "author": "Masjid",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/scanner-release.mjs && bun run build && electron-builder --win nsis",
    "dist:package": "node scripts/scanner-release.mjs && bun run build && electron-builder --win nsis --publish never --config.win.signExecutable=true && bun run verify:update",
    "dist:publish": "bun run dist:package && bun run publish:verified",
    "publish:verified": "node scripts/publish-verified.mjs",
    "release": "node scripts/release.mjs",
    "lint": "node scripts/security-lint.mjs",
    "lint:history": "node scripts/security-lint.mjs --history HEAD",
    "setup:hooks": "node scripts/install-hooks.mjs",
    "test": "node --test test/core.test.mjs test/integration/*.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:update": "node scripts/verify-update-artifacts.mjs"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "google-auth-library": "^10.3.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.64.0",
    "electron": "44.9.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^4.0.1",
    "vite": "6.4.5"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.masjid.attendance",
    "productName": "Masjid Attendance",
    "directories": {
      "output": "release"
    },
    "files": ["out/**", "package.json", "LICENSE"],
    "afterPack": "scripts/verify-package.cjs",
    "asar": true,
    "extraResources": [
      {
        "from": "staging/scanner",
        "to": "scanner"
      },
      {
        "from": "src/renderer/fonts",
        "to": "fonts",
        "filter": ["OFL-*.txt"]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "executableName": "Masjid Attendance",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "guid": "2febcda6-3658-5c7c-9dfa-528fe71d9a9a",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Masjid Attendance",
      "uninstallDisplayName": "Masjid Attendance",
      "artifactName": "Masjid-Attendance-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "NasoohOlabi",
      "repo": "attendance-app",
      "releaseType": "release"
    }
  }
}
