<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>zk4500</AssemblyName>
    <RootNamespace>ZK4500Cli</RootNamespace>
    <StartupObject>ZK4500Cli</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AxInterop.ZKFPEngXControl">
      <HintPath>AxInterop.ZKFPEngXControl.dll</HintPath>
    </Reference>
    <Reference Include="Interop.ZKFPEngXControl">
      <HintPath>Interop.ZKFPEngXControl.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
</Project>
